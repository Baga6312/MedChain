                  "pm.test('created, forbidden, or rejected by a business rule', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 403]);",
                  "});",
                  "if (pm.response.code === 400) {",
                  "  console.log('business rule:', JSON.stringify(pm.response.json()));",
                  "}"
                ]
              }
