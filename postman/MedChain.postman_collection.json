              "mode": "raw",
              "raw": "{\n  \"id\": {{appointment_id}},\n  \"patient\": {{patient_id}},\n  \"doctor\": {{doctor_id}},\n  \"date\": \"2026-12-01T10:00:00Z\",\n  \"notes\": \"postman booking\",\n  \"status\": \"completed\"\n}"
            },
            "url": "{{baseUrl}}/api/appointments/{{appointment_id}}/",
