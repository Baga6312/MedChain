            },
            "url": "{{baseUrl}}/api/patients/1/permissions/",
            "description": "An admin's access is implicit and must never become a durable share. Run 'Login as admin' first."
          }
        }
      ]
    },
    {
      "name": "7. Security checks",
      "description": "Negative and abuse cases at the trust boundaries.",
      "item": [
        {
          "name": "Anonymous read (expect 401)",
