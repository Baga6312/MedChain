          "name": "List (scoped to granted charts)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list returns 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "if (Array.isArray(rows) && rows.length) {",
                  "  pm.collectionVariables.set('record_id', rows[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/medical-records/"
          }
        },
        {
          "name": "Retrieve by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, 403 or 404', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 403, 404]);",
                  "});",
                  "if (pm.response.code === 403) {",
                  "  console.log('403 = access revoked, not merely out of scope');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/medical-records/{{record_id}}/",
            "description": "Every read of a record is written to AuditLog."
          }
        },
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created or forbidden', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": {{patient_id}},\n  \"title\": \"Postman record\",\n  \"content\": \"created from postman\"\n}"
            },
            "url": "{{baseUrl}}/api/medical-records/",
            "description": "created_by is taken from the token, never from the body - a forged created_by in the payload is ignored."
          }
        },
        {
          "name": "Move record to another patient (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reassignment refused', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{record_id}},\n  \"patient\": 9999,\n  \"title\": \"moved\",\n  \"content\": \"x\"\n}"
            },
            "url": "{{baseUrl}}/api/medical-records/{{record_id}}/",
            "description": "The patient FK is writable in the serializer, so this guard is what stops an authorized caller re-pointing a record onto a chart they do not own. Without it, owning one chart would be enough to hijack any record id."
          }
        },
        {
          "name": "Delete (admin only)",
          "event": [
