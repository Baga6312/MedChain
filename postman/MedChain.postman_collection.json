{
  "info": {
    "name": "MedChain API - auth contract",
    "description": "Postman collection for the role-scoped healthcare API.\n\nHOW TO RUN\n1. Import this file (Import -> File).\n2. Run the whole collection in order, top to bottom. Each folder depends on\n   the ids captured by the ones above it.\n3. The seed command creates these accounts, all with password DemoPass123!:\n     patient1..patient5  (role PATIENT)\n     doctor1..doctor3    (role DOCTOR)\n     admin               (role ADMIN)\n\nTHROTTLE WARNING\nPOST /api/auth/login/ is rate limited to 10 per minute. Three logins run per\nfull pass, so repeated back-to-back passes can return 429 on the login requests\nonly. If that happens, wait 60s; the rest of the collection is unaffected.\n\nBase URL: http://localhost:8000 hits the backend directly. Use\nhttp://localhost to go through the nginx gateway instead - both work.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// DRF TokenAuthentication requires the literal word 'Token'. The Bearer",
          "// preset Postman offers by default sends 'Bearer' and gets 401.",
          "const token = pm.collectionVariables.get('token');",
          "if (token) {",
          "  pm.request.headers.add({ key: 'Authorization', value: 'Token ' + token });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "role",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "record_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "appointment_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Login captures the token and ids into collection variables. The pre-request script on the collection adds the Authorization header automatically for every other request.",
      "item": [
        {
          "name": "Login as patient1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is PATIENT', () => pm.expect(body.role).to.eql('PATIENT'));",
                  "pm.test('token is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  pm.collectionVariables.set('role', body.role);",
                  "  if (body.patient_id) pm.collectionVariables.set('patient_id', body.patient_id);",
                  "  if (body.doctor_id) pm.collectionVariables.set('doctor_id', body.doctor_id);",
                  "}",
                  "console.log('logged in as', body.username, body.role);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"patient1\",\n  \"password\": \"DemoPass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/",
            "description": "Returns token, user_id, username, role, and patient_id."
          }
        },
        {
          "name": "Login as doctor1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is DOCTOR', () => pm.expect(body.role).to.eql('DOCTOR'));",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  pm.collectionVariables.set('role', body.role);",
                  "  if (body.doctor_id) pm.collectionVariables.set('doctor_id', body.doctor_id);",
                  "  if (body.patient_id) pm.collectionVariables.set('patient_id', body.patient_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"doctor1\",\n  \"password\": \"DemoPass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/",
            "description": "Overwrites the token. Run 'Login as patient1' again before any patient-scoped check."
          }
        },
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is ADMIN', () => pm.expect(body.role).to.eql('ADMIN'));",
                  "if (body.token) pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"DemoPass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/"
          }
        },
        {
          "name": "Login with wrong password (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('bad credentials rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"patient1\",\n  \"password\": \"not-the-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login/",
            "description": "A failed login is recorded in AuditLog with the attempted username only."
          }
        },
        {
          "name": "Clear token (logout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', '');",
                  "pm.collectionVariables.set('role', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/schema/",
            "description": "Clears the token so the 'Anonymous' folder returns 401. Hit Send."
          }
        }
      ]
    },
    {
      "name": "2. Patients",
      "item": [
        {
          "name": "List (as current role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list returns 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "const role = pm.collectionVariables.get('role');",
                  "pm.test('scoped by role', () => {",
                  "  if (role === 'ADMIN') pm.expect(rows.length).to.be.above(0);",
                  "  else pm.expect(rows.length).to.be.below(6);",
                  "});",
                  "if (Array.isArray(rows) && rows.length) {",
                  "  pm.collectionVariables.set('patient_id', rows[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/"
          }
        },
        {
          "name": "Retrieve by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('retrieve returns 200 or 404', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/patients/{{patient_id}}/",
            "description": "404 here is correct when the row is outside your role's scope - that is the point."
          }
        },
        {
          "name": "Create (admin only, expect 403 as patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('either created or forbidden', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 403]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const created = pm.response.json();",
                  "  console.log('created patient id', created.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Patient\",\n  \"birth_date\": null,\n  \"phone\": \"20999999\"\n}"
            },
            "url": "{{baseUrl}}/api/patients/",
            "description": "birth_date must be present even though it is nullable - omitting it returns 400. Do NOT send 'id'; it is read-only on create."
          }
        },
        {
          "name": "Update (PUT, id required in body)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update returns 200 or 403', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{patient_id}},\n  \"name\": \"Postman Test Patient\",\n  \"birth_date\": null,\n  \"phone\": \"20999998\"\n}"
            },
            "url": "{{baseUrl}}/api/patients/{{patient_id}}/",
            "description": "PUT names its target row through 'id' in the body, and that id must match the URL."
          }
        },
        {
          "name": "Delete (admin only, expect 403 otherwise)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete returns 200, 403 or 404', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 403, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/patients/{{patient_id}}/",
            "description": "A patient cannot delete their own row: it cascades to records and appointments that belong to clinicians."
          }
        }
      ]
    },
