                  "pm.test('update accepted', () => pm.response.to.have.status(200));",
                  "pm.test('status was NOT changed', () => {",
                  "  const list = pm.collectionVariables.get('__status_probe');",
                  "  pm.expect(list).to.be.undefined;",
                  "});"
