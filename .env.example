# Copy this file to .env and replace all placeholder values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO
LOG_SERVICE_NAME=medchain-backend
LOG_ENVIRONMENT=development
LOG_FILE_PATH=/app/logs/medchain.jsonl
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_EXTERNAL_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
KIBANA_PORT=5601
KIBANA_EXTERNAL_PORT=5601

DB_NAME=medchain
DB_USER=shops
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5432

REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

MEDCHAIN_ADMIN_EMAIL=admin@medchain.local
MEDCHAIN_ADMIN_PASSWORD=replace-with-a-local-password
MEDCHAIN_DEMO_PASSWORD=replace-with-a-demo-password

GATEWAY_PORT=80
GATEWAY_LISTEN_PORT=80
BACKEND_HOST=backend
BACKEND_PORT=8000
FRONTEND_HOST=frontend
FRONTEND_PORT=80

# Optional Google OAuth configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/oauth/callback

# Frontend development server only.
VITE_API_PROXY_TARGET=http://localhost:8000
